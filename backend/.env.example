PORT=4000
DATABASE_URL=postgres://bugdr:bugdr@localhost:5432/bugdr
TEST_DATABASE_URL=postgres://bugdr:bugdr@localhost:5432/bugdr_test
# Required in production: a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=
# Admin login at /admin/login (D48). Never the plain password here: run `npm run hash-password`
# and paste the line it prints. Leave empty to switch admin login off.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# AI analysis on Add Problem (A10, A9.1): set ANTHROPIC_API_KEY or OPENAI_API_KEY. Without either the analysis
# step fails with "not set on the server". With both, AI_PROVIDER picks one (default: anthropic).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# AI_PROVIDER=anthropic
# Built-in AI chat on the solve page (S1) uses the same key with a cheap model and a daily token limit per user.
# AI_FREE_MODEL=claude-haiku-4-5   (default per provider: claude-haiku-4-5 / gpt-4o-mini)
# AI_FREE_DAILY_TOKENS=20000
# Users can connect their own Anthropic/OpenAI key in Settings (S6). Their keys are encrypted with this master key:
# 64 hex characters from `openssl rand -hex 32`. Leave empty to switch it off. Changing it makes saved keys unreadable
# (users connect them again).
API_KEY_ENCRYPTION_KEY=
