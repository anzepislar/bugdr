PORT=4000
DATABASE_URL=postgres://bugdr:bugdr@localhost:5432/bugdr
TEST_DATABASE_URL=postgres://bugdr:bugdr@localhost:5432/bugdr_test
# Required in production: a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=
# Admin login at /admin/login (D48). Never the plain password here: run `npm run hash-password`
# and paste the line it prints. Leave empty to switch admin login off.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# AI analysis on Add Problem (A10). Without a key the analysis step fails with "not set on the server".
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
